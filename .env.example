# Annona configuration — copy to `.env` and fill in. NEVER commit `.env`.
# Variables are introduced phase by phase; commented ones are not used yet.

# ---------- Server ----------
# Default: ./data/annona.db locally, /data/annona.db (a Docker volume) in Docker. Leave it
# commented when using Docker, or the database ends up outside the volume.
# ANNONA_DATABASE_URL=sqlite:///./data/annona.db
# REQUIRED for the API: a long random secret, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ANNONA_API_TOKEN=
# Comma-separated origins allowed to call the API from a browser (not needed for the app).
# ANNONA_CORS_ORIGINS=http://localhost:8081

# ---------- Daily price refresh (scheduler service) ----------
# Providers separated by ";", options by ",". Opt-in providers need accept_notice=yes and only
# refresh the products you follow (pantry, active plans, shopping lists), at most 50.
# ANNONA_REFRESH_PROVIDERS=open_prices:brand=Mercadona;mercadona:postal_code=28001,accept_notice=yes
# ANNONA_REFRESH_AT=04:30               # UTC, off-peak
# ANNONA_REFRESH_CATALOG_LIMIT=500      # open data providers only

# ---------- AI provider (any LiteLLM model id: provider/model) ----------
# Defaults: deepseek/deepseek-flash (small) and deepseek/deepseek-v4-pro (large).
# ANNONA_LLM_MODEL_SMALL=deepseek/deepseek-flash   # classification, receipts, chat
# ANNONA_LLM_MODEL_LARGE=deepseek/deepseek-v4-pro  # weekly plan, recipes
# ANNONA_LLM_THINKING=off      # provider "thinking" mode (costs more); on|off
# ANNONA_LLM_TIMEOUT_S=60
# Provider keys use each provider's standard variable name (only set the one you use):
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ---------- Language ----------
# Language of generated menus and recipes (es, en).
# ANNONA_LANGUAGE=es

# ---------- Evals ----------
# Maximum total spend on eval runs (USD) recorded in the database.
# ANNONA_EVAL_BUDGET_USD=1.00

# ---------- Contact ----------
# Your email, sent in the User-Agent to services that ask API clients for a contact
# (Open Food Facts). Each person running Annona sets their own; leave empty to omit it.
ANNONA_CONTACT_EMAIL=

# ---------- Supermarket providers ----------
# Overrides the default User-Agent sent by supermarket plugins (identify yourself politely):
# ANNONA_HTTP_USER_AGENT=Annona/0.0 (+https://github.com/Kenobiiii/Annona)
